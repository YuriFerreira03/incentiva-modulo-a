# ============================================================
# INCENTIVA — Módulo A · Configuração de IA
# ============================================================
# Copie este arquivo para .env e preencha sua chave de API.
# IMPORTANTE: o arquivo .env NUNCA deve ser commitado.
#
# RECOMENDAÇÃO (free tier mais generoso em 2026):
# OpenRouter — https://openrouter.ai/ — dá acesso a vários
# modelos gratuitos (DeepSeek, Llama, Gemini, etc.) com uma única chave.
#
# Alternativas gratuitas:
#  - Groq         (https://console.groq.com/keys) — extremamente rápido
#  - Google AI    (https://aistudio.google.com/app/apikey) — Gemini
#  - Together AI  (https://api.together.xyz/) — vários modelos open
#
# Sem chave configurada, o protótipo continua funcionando com
# respostas simuladas (fallback local) — útil para demonstração.
# ============================================================

# Provedor: openrouter | groq | google | together | mock
VITE_AI_PROVIDER=groq

# Sua chave de API
VITE_AI_API_KEY=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

# Modelo a ser usado (ver lista no README)
# Exemplos:
#   OpenRouter: deepseek/deepseek-chat-v3.1:free
#               meta-llama/llama-3.3-70b-instruct:free
#               google/gemini-2.0-flash-exp:free
#   Groq:       llama-3.3-70b-versatile
#   Google:     gemini-2.0-flash
VITE_AI_MODEL=llama-3.3-70b-versatile
